DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=gdutnic
MYSQL_USER=gdutnic
MYSQL_PASSWORD=replace-with-your-database-password
# Only needed by the local Docker MySQL service:
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# For remote MySQL with TLS:
# Relative certificate paths are resolved inside data/ (data/certs/ca.pem):
# MYSQL_SSL_CA=certs/ca.pem
# SESSION_SECRET=replace-with-a-long-random-secret

# GDUTNIC SSO: prefer the administrator console configuration; saved settings override these fallbacks.
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=https://sso.gdutnic.com/realms/nic
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Exact externally accessible callback URL registered in Keycloak:
KEYCLOAK_REDIRECT_URI=
# Leave blank until a login confirms which trusted claim matches local names.
# Set preferred_username (or an administrator-managed custom claim) to enable auto-linking.
KEYCLOAK_USERNAME_CLAIM=
